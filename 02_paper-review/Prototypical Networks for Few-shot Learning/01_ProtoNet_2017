      "source": [
        "Ablation Study — Squared Euclidean vs. Cosine Distance\n",
        "This directly tests the paper's key claim in Section 2.6: squared Euclidean distance outperforms cosine distance because cosine distance is not a Bregman divergence."
      ],
      "metadata": {
        "id": "SulXwURWWjZ6"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def prototypical_loss_metric(model, support_x, query_x, query_y, n_way, k_shot, metric='euclidean'):\n",
        "    z_support = model(support_x)\n",
        "    z_query   = model(query_x)\n",
        "    prototypes = z_support.view(n_way, k_shot, -1).mean(dim=1)\n",
        "\n",
        "    if metric == 'euclidean':\n",
        "        # Squared Euclidean distance (Paper's method)\n",
        "        logits = -(torch.cdist(z_query, prototypes) ** 2)\n",
        "    elif metric == 'cosine':\n",
        "        # Cosine similarity scaled by temperature (standard baseline)\n",
        "        z_query_norm = F.normalize(z_query, p=2, dim=1)\n",
        "        proto_norm   = F.normalize(prototypes, p=2, dim=1)\n",
        "        logits = torch.mm(z_query_norm, proto_norm.t()) * 10.0  # Scale factor for softmax sharpness\n",
        "\n",
        "    log_p_y = F.log_softmax(logits, dim=1)\n",
        "    loss = F.nll_loss(log_p_y, query_y)\n",
        "    acc = (log_p_y.argmax(dim=1) == query_y).float().mean().item()\n",
        "    return loss, acc\n",
        "\n",
        "def train_and_eval(metric_name):\n",
        "    net = ProtoNet().to(device)\n",
        "    opt = torch.optim.Adam(net.parameters(), lr=1e-3)\n",
        "\n",
        "    for epoch in range(10):\n",
        "        net.train()\n",
        "        for _ in range(100):\n",
        "            sx, qx, qy = sample_episode(train_classes, n_way=20, k_shot=5, q_query=5)\n",
        "            opt.zero_grad()\n",
        "            loss, _ = prototypical_loss_metric(net, sx, qx, qy, 20, 5, metric=metric_name)\n",
        "            loss.backward()\n",
        "            opt.step()\n",
        "\n",
        "    net.eval()\n",
        "    accs = []\n",
        "    with torch.no_grad():\n",
        "        for _ in range(200):\n",
        "            sx, qx, qy = sample_episode(test_classes, n_way=5, k_shot=5, q_query=5)\n",
        "            _, acc = prototypical_loss_metric(net, sx, qx, qy, 5, 5, metric=metric_name)\n",
        "            accs.append(acc)\n",
        "    return np.mean(accs) * 100\n",
        "\n",
        "acc_euclid = train_and_eval('euclidean')\n",
        "acc_cosine = train_and_eval('cosine')\n",
        "\n",
        "print(f\"5-way 5-shot Test Accuracy (Squared Euclidean): {acc_euclid:.2f}%\")\n",
        "print(f\"5-way 5-shot Test Accuracy (Cosine Distance):    {acc_cosine:.2f}%\")"
      ],
