      "cell_type": "code",
      "source": [
        "import random\n",
        "import numpy as np\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "from torch.utils.data import Dataset\n",
        "from torchvision import datasets, transforms\n",
        "\n",
        "# Set device and random seeds\n",
        "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
        "print(\"Using device:\", device)\n",
        "\n",
        "torch.manual_seed(42)\n",
        "np.random.seed(42)\n",
        "random.seed(42)\n",
        "\n",
        "# Download Omniglot (background = train, evaluation = test)\n",
        "transform = transforms.Compose([\n",
        "    transforms.Resize((28, 28)),\n",
        "    transforms.ToTensor()\n",
        "])\n",
        "\n",
        "train_raw = datasets.Omniglot(root='./data', background=True, download=True, transform=transform)\n",
        "test_raw  = datasets.Omniglot(root='./data', background=False, download=True, transform=transform)\n",
        "\n",
        "# Group images by class label\n",
        "def group_by_class(dataset):\n",
        "    class_dict = {}\n",
        "    for img, label in dataset:\n",
        "        class_dict.setdefault(label, []).append(img)\n",
        "    return class_dict\n",
        "\n",
        "train_classes = group_by_class(train_raw)\n",
        "test_classes  = group_by_class(test_raw)\n",
        "\n",
        "print(f\"Train classes: {len(train_classes)}, Test classes: {len(test_classes)}\")"
