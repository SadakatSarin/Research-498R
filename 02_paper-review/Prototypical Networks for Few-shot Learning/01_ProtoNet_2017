      "cell_type": "markdown",
      "source": [
        " Episodic Sampler (Creates N-way K-shot Tasks)Each episode randomly picks $N$ classes, $K$ support images per class, and $Q$ query images per class.   "
      ],
      "metadata": {
        "id": "cD3-9RACvMe5"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def sample_episode(class_dict, n_way=5, k_shot=5, q_query=5):\n",
        "    selected_classes = random.sample(list(class_dict.keys()), n_way)\n",
        "    support_imgs, query_imgs = [], []\n",
        "\n",
        "    for cls in selected_classes:\n",
        "        imgs = random.sample(class_dict[cls], k_shot + q_query)\n",
        "        support_imgs.extend(imgs[:k_shot])\n",
        "        query_imgs.extend(imgs[k_shot:])\n",
        "\n",
        "    support_x = torch.stack(support_imgs).to(device)  # [n_way * k_shot, 1, 28, 28]\n",
        "    query_x   = torch.stack(query_imgs).to(device)    # [n_way * q_query, 1, 28, 28]\n",
        "\n",
        "    # Labels for queries: [0, 0, ..., 1, 1, ..., n_way-1]\n",
        "    query_y = torch.arange(n_way, device=device).repeat_interleave(q_query)\n",
        "    return support_x, query_x, query_y"
      ],
      "metadata": {
        "id": "m0E55CXQvPmH"
      },
      "execution_count": 4,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "4-Block CNN Encoder & Prototypical Loss\n",
        "This implements the exact 4-block encoder and squared Euclidean distance loss from the paper."
      ],
      "metadata": {
        "id": "cgHzzck_yAGM"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def conv_block(in_channels, out_channels):\n",
        "    return nn.Sequential(\n",
        "        nn.Conv2d(in_channels, out_channels, kernel_size=3, padding=1),\n",
        "        nn.BatchNorm2d(out_channels),\n",
        "        nn.ReLU(),\n",
        "        nn.MaxPool2d(2)\n",
        "    )\n",
        "\n",
        "class ProtoNet(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.encoder = nn.Sequential(\n",
        "            conv_block(1, 64),\n",
        "            conv_block(64, 64),\n",
        "            conv_block(64, 64),\n",
        "            conv_block(64, 64)\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        # Output shape for 28x28 input: [batch, 64, 1, 1] -> [batch, 64]\n",
        "        return self.encoder(x).view(x.size(0), -1)\n",
        "\n",
        "def prototypical_loss(model, support_x, query_x, query_y, n_way, k_shot):\n",
        "    # 1. Embed support and query images\n",
        "    z_support = model(support_x)  # [n_way * k_shot, 64]\n",
        "    z_query   = model(query_x)    # [n_way * q_query, 64]\n",
        "\n",
        "    # 2. Compute prototypes by averaging support vectors per class\n",
        "    prototypes = z_support.view(n_way, k_shot, -1).mean(dim=1)  # [n_way, 64]\n",
        "\n",
        "    # 3. Squared Euclidean distance between each query and each prototype\n",
        "    dists = torch.cdist(z_query, prototypes) ** 2  # [n_way * q_query, n_way]\n",
        "\n",
        "    # 4. Log-softmax over negative distances\n",
        "    log_p_y = F.log_softmax(-dists, dim=1)\n",
        "    loss = F.nll_loss(log_p_y, query_y)\n",
        "\n",
        "    # Calculate accuracy\n",
        "    preds = log_p_y.argmax(dim=1)\n",
        "    acc = (preds == query_y).float().mean().item()\n",
        "    return loss, acc"
      ],
      "metadata": {
        "id": "yYKMQD8HyCWU"
      },
      "execution_count": 5,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "Train & Test on Unseen Classes\n",
        "Following the paper's finding, we train with a higher \"way\" (20-way) than we test on (5-way)."
      ],
      "metadata": {
        "id": "JMeRxEGayFsM"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "model = ProtoNet().to(device)\n",
        "optimizer = torch.optim.Adam(model.parameters(), lr=1e-3)\n",
        "\n",
        "# Training: 20-way 5-shot (10 epochs x 100 episodes = 1,000 episodes)\n",
        "for epoch in range(1, 11):\n",
        "    model.train()\n",
        "    total_loss, total_acc = 0, 0\n",
        "\n",
        "    for _ in range(100):\n",
        "        support_x, query_x, query_y = sample_episode(train_classes, n_way=20, k_shot=5, q_query=5)\n",
        "        optimizer.zero_grad()\n",
        "        loss, acc = prototypical_loss(model, support_x, query_x, query_y, n_way=20, k_shot=5)\n",
        "        loss.backward()\n",
        "        optimizer.step()\n",
        "\n",
        "        total_loss += loss.item()\n",
        "        total_acc += acc\n",
        "\n",
        "    print(f\"Epoch {epoch:02d} | Train Loss: {total_loss/100:.4f} | Train Acc (20-way): {total_acc:.2f}%\")\n",
        "\n",
        "# Evaluation on unseen test classes: 5-way 5-shot over 200 episodes\n",
        "model.eval()\n",
        "test_acc = 0\n",
        "with torch.no_grad():\n",
        "    for _ in range(200):\n",
        "        support_x, query_x, query_y = sample_episode(test_classes, n_way=5, k_shot=5, q_query=5)\n",
        "        _, acc = prototypical_loss(model, support_x, query_x, query_y, n_way=5, k_shot=5)\n",
        "        test_acc += acc\n",
        "\n",
        "print(f\"\\nTest Accuracy on Unseen Classes (5-way 5-shot): {test_acc/200 * 100:.2f}%\")"
      ],
